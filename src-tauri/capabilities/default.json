{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "http:default",
    "clipboard-manager:default",
    {
      "identifier": "http:default",
      "allow": [
        {"url": "http://**"}, 
        {"url": "https://**"}, 
        {"url": "http://100.108.38.25:11434/**"},
        {"url": "http://*:*/**"}
      ]
    }
  ]
}
